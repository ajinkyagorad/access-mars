{
  "name": "access-mars",
  "version": "0.0.1",
  "description": "",
  "license": "Apache-2.0",
  "scripts": {
    "start": "npm run build-css && npm run copy-aframe && npm run budo",
    "copy-aframe": "node -e \"require('fs').copyFileSync('node_modules/aframe/dist/aframe-master.min.js', 'public/js/aframe.min.js')\"",
    "build": "npm run copy-aframe && browserify --exclude=aframe src/js/vr.js > public/js/vr.js",
    "buildmin": "npm run copy-aframe && browserify -g uglifyify --exclude=aframe src/js/vr.js > public/js/vr.js",
    "build-css": "sass --load-path=scss src/scss/main.scss public/css/vr.css",
    "budo": "budo src/js/vr.js:js/vr.js --dir ./public --live --verbose --port 3002",
    "discify": "browserify --full-paths src/js/vr.js | discify --open",
    "build-dev": "npm run build-css && npm run copy-aframe && npm run build",
    "deploy-all": "npm run build-css && npm run copy-aframe && npm run build && gcloud app deploy -q",
    "deploy": "npm run build-css && npm run copy-aframe && npm run build && gcloud app deploy -q"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^18.6.4",
    "aframe": "1.8.0",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "bezier-easing": "2.0.3",
    "clone-deep": "^1.0.0",
    "eventemitter3": "2.0.2",
    "ios-safe-audio-context": "1.0.1",
    "promise-polyfill": "6.0.2",
    "qs": "6.4.0",
    "screenfull": "^3.3.1",
    "sono": "^2.1.2",
    "web-audio-player": "1.3.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "babel-core": "^6.26.3",
    "babel-preset-es2015": "^6.16.0",
    "babel-preset-stage-2": "^6.22.0",
    "babelify": "^8.0.0",
    "browserify": "^16.5.2",
    "budo": "^9.4.7",
    "derequire": "^2.0.3",
    "discify": "^1.6.0",
    "sass": "1.77.8"
  },
  "keywords": [
    "vr",
    "webvr"
  ],
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "es2015"
          ],
          "plugins": [
            "transform-object-rest-spread"
          ]
        }
      ]
    ]
  },
  "resolutions": {
    "document-register-element": "1.3.0"
  }
}
