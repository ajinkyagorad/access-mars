{
  "name": "access-mars",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "start": "npm run build-css && npm run budo",
    "build": "browserify src/js/vr.js -t babelify > public/js/vr.js",
    "build-css": "sass scss/main.scss public/css/vr.css",
    "budo": "budo src/js/vr.js:js/vr.js --dir ./public --live --verbose"
  },
  "dependencies": {
    "aframe": "googlecreativelab/aframe#v0.6.0c-mod",
    "aframe-daydream-controller-component": "jeremyabel/aframe-daydream-controller-component",
    "tween.js": "^16.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "budo": "^11.0.0",
    "sass": "^1.70.0"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ]
        }
      ]
    ]
  }
}
